# Copy this file to .env and fill in real values before deploying.
# Never commit the real .env file to git.

# --- Core ---
NODE_ENV=production
PORT=3000
SITE_URL=https://www.idreamofthought.org
# Any long random string — generate one with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# TESTING ONLY — set to "true" and every signup/login gets 24h free,
# auto-verified access with no payment. Server prints a loud warning on
# startup whenever this is on so it's hard to miss. Leave unset (or
# anything other than "true") for real players — REMOVE this line
# entirely once you're done testing, don't just comment it out.
DEV_FREE_PLAY=

# Set to 1 only if you're behind a reverse proxy / platform load balancer
# (nginx, Render, Railway, etc.) — needed so rate limiting and login see
# the real visitor IP instead of the proxy's IP for every request.
TRUST_PROXY=0

# --- Stripe (card payments) ---
# From dashboard.stripe.com > Developers > API keys
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
# From dashboard.stripe.com > Developers > Webhooks, after adding an
# endpoint pointed at https://www.idreamofthought.org/api/webhook/stripe
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- PayPal ---
# Your "no-code" Pay Link, created from paypal.com Business account >
# Pay Links & Buttons. This is the actual link the Pay with PayPal
# button redirects to.
PAYPAL_PAY_LINK=https://www.paypal.com/ncp/payment/8ATPT5QPE3NR2

# These two are still needed even though we're not creating orders via
# API — they're used only to verify that incoming webhook calls really
# came from PayPal. From developer.paypal.com > Apps & Credentials
# (Sandbox creds while testing, Live creds once you're ready for real
# payments — same account that owns the Pay Link above).
PAYPAL_CLIENT_ID=REPLACE_ME
PAYPAL_CLIENT_SECRET=REPLACE_ME

# From developer.paypal.com > Apps & Credentials > your app > Webhooks
# > Add Webhook, pointed at:
#   https://www.idreamofthought.org/api/webhook/paypal-link
# Subscribe to the "Checkout order approved" event. After creating it,
# copy the Webhook ID shown (looks like a long numeric string) here.
PAYPAL_WEBHOOK_ID=REPLACE_ME

# --- Email (verification links) ---
# Works with any SMTP-capable provider: SendGrid, Postmark, Resend,
# AWS SES, Mailgun, or even a plain Gmail account for testing.
# If SMTP_HOST is left blank, verification links are printed to the
# server console instead of emailed — fine for local testing, NOT for
# production (players would never see their link).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Portus <no-reply@idreamofthought.org>"
